{
  "name": "Pi-hole DNS",
  "version": "1.2.4",
  "slug": "pihole_dns",
  "description": "Pi-hole DNS Server im Host-Netzwerk",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "services",
  "boot": "auto",
  "host_network": true,
  "ingress": false,
  "panel_icon": "mdi:pi-hole",
  "panel_title": "Pi-hole",
  "webui": "http://[HOST]:[PORT:8081]/admin/",
  "ports": {
    "8081/tcp": 8081
  },
  "ports_description": {
    "8081/tcp": "Web Interface"
  },
  "options": {
    "env:FTLCONF_webserver_api_password": "meinpasswort"
  },
  "schema": {
    "env:FTLCONF_webserver_api_password": "password"
  },
  "privileged": [
    "NET_ADMIN"
  ],
  "map": [
    "addon_config:rw"
  ]
}
