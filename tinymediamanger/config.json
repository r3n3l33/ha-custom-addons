{
  "name": "tinyMediaManager v5",
  "version": "5.3.5",
  "slug": "tinymediamanager",
  "description": "Media-Scraper mit VNC, Web UI ingress und API Control",
  "arch": ["aarch64", "amd64"],
  "startup": "application",
  "boot": "auto",
  "ingress": true,
  "ingress_port": 4000,
  "panel_icon": "mdi:movie-open",
  "panel_title": "tMM",
  "ports": {
    "4000/tcp": 4000,
    "5900/tcp": 5900,
    "7878/tcp": 7878
  },
  "ports_description": {
    "4000/tcp": "Web UI (HTTP)",
    "5900/tcp": "VNC Direct Access",
    "7878/tcp": "API Control Port"
  },
  "map": [
    "addon_config:rw",
    "media:rw",
    "share:rw"
  ],
  "hassio_role": "default"
}
