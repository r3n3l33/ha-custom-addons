{
  "name": "JDownloader 2 (VNC)",
  "version": "1.1337",
  "slug": "jdownloader2",
  "description": "JDownloader 2 mit VNC Web-Interface, Ingress & MyJDownloader Support",
  "arch": ["aarch64", "amd64"],
  "startup": "application",
  "boot": "auto",
  "ingress": true,
  "ingress_port": 5800,
  "panel_title": "JDownloader",
  "panel_icon": "mdi:download",
  "ports": {
    "5800/tcp": 5800,
    "5901/tcp": 5901,
    "3129/tcp": 3129
  },
  "ports_description": {
    "5800/tcp": "Web UI / VNC Port",
    "5901/tcp": "Standard VNC Port",
    "3129/tcp": "MyJDownloader Port"
  },
  "map": [
    "addon_config:rw",
    "media:rw",
    "share:rw"
  ],
  "hassio_role": "default"
}
