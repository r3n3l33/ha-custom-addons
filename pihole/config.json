{
  "name": "Pi-hole DNS",
  "version": "1.2.0",
  "slug": "pihole_dns",
  "description": "Pi-hole DNS Server im Host-Netzwerk",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "services",
  "boot": "auto",
  "host_network": true,
  "ingress": true,
  "ingress_port": 8081,
  "panel_icon": "mdi:pi-hole",
  "panel_title": "Pi-hole",
  "webui": "http://[HOST]:[PORT:8081]/admin/",
  "privileged": [
    "NET_ADMIN"
  ],
  "map": [
    "addon_config:rw"
  ]
}
