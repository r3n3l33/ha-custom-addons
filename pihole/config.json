{
  "name": "Pi-hole DNS",
  "version": "1.1.0",
  "slug": "pihole_dns",
  "description": "Pi-hole DNS Server im Host-Netzwerk mit Ingress-Anbindung",
  "arch": ["aarch64", "amd64"],
  "startup": "services",
  "boot": "auto",
  "host_network": true,
  "ingress": true,
  "ingress_port": 8081,
  "ingress_entry": "/admin/login.php",
  "panel_icon": "mdi:pi-hole",
  "panel_title": "Pi-hole",
  "privileged": ["NET_ADMIN"],
  "map": [
    "addon_config:rw"
  ]
}
